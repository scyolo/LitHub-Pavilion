# Copy to .env; never commit credentials.
CONTACT_EMAIL=
S2_API_KEY=
# Set https on Fake-IP/TUN networks; public-address and TLS validation remain enforced.
OUTBOUND_DNS_MODE=system
# Link-only release: no PDF downloads.
PDF_DOWNLOAD_ENABLED=false
SCHEDULER_ENABLED=true
LINKS_MAX_BATCHES=20
WEB_PORT=8080
# Docker starts collection over 2023..current UTC year; existing complete historical units resume.
STARTUP_CRAWL_ENABLED=true
STARTUP_YEAR_FROM=2023
# Leave empty to include the current UTC year.
STARTUP_YEAR_TO=
SNAPSHOT_ENABLED=true
# Local Python exports where the standalone frontend can read it; Docker uses its data volume.
SNAPSHOT_DIR=./frontend/static/snapshot
# Enable publication with the pages compose override and a local secret file.
PAGES_PUBLISH_ENABLED=false
PAGES_REPOSITORY=scyolo/LitHub-Pavilion
# Local Python path; Docker overrides it with the read-only secret mount.
PAGES_TOKEN_FILE=./.secrets/github_token
PAGES_RETRY_SECONDS=300
# Retry accepted builds only after this delay if the website still has an older revision.
PAGES_DEPLOY_RETRY_SECONDS=1800
# Optional canonical HTTPS URL for a custom Pages domain; otherwise owner.github.io/repo/.
PAGES_SITE_URL=
# Optional TLS SMTP alert settings.
ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
